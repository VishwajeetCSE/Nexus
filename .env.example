# ==========================================
# NEXUS - CAMPUSPULSE GLOBAL ENV CONFIGURATION
# ==========================================

# Application URLs
NEXT_PUBLIC_APP_NAME="Nexus: CampusPulse Global"
NEXT_PUBLIC_APP_URL="https://nexus-campuspulse.vercel.app"

# Optional Database & Auth Engine: Supabase
# When provided, the app can sync live data with Supabase PostgreSQL.
# If omitted, the app runs in resilient offline-first mode with full localStorage persistence & seed data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Global Hackathon Deployment Flag
NEXT_PUBLIC_ENVIRONMENT=production
